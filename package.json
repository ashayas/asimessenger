{
  "name": "asi-messenger",
  "productName": "ASI Messenger",
  "version": "0.1.0",
  "description": "A Messenger-style home for your coding agents.",
  "license": "Apache-2.0",
  "author": "Ashaya Sharma <ashayasharma@gmail.com>",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm assets && electron-vite build && playwright test",
    "lint": "eslint .",
    "test:live": "ASI_LIVE=1 vitest run --config vitest.live.config.ts",
    "icons": "electron scripts/make-icons.cjs",
    "assets": "node scripts/copy-excalidraw-assets.mjs",
    "predev": "pnpm assets",
    "prebuild": "pnpm assets",
    "postinstall": "node scripts/copy-excalidraw-assets.mjs",
    "dist": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "test:packaged":"playwright test -c playwright.packaged.config.ts",
    "dist:dir": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never",
    "release:signed": "bash scripts/release-signed.sh"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@libsql/client": "^0.18.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.asimessenger.app",
    "productName": "ASI Messenger",
    "copyright": "Apache-2.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "assets/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@libsql/**",
      "node_modules/libsql/**",
      "node_modules/@lydell/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ASI Messenger records your voice only when you hold the push-to-talk key, and transcribes it on this Mac.",
        "NSSpeechRecognitionUsageDescription": "ASI Messenger uses Apple on-device speech recognition to turn your voice into text. Audio never leaves your Mac.",
        "NSAppleEventsUsageDescription": "ASI Messenger opens a chat session in Terminal when you ask it to."
      }
    },
    "dmg": {
      "title": "ASI Messenger",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "artifactName": "ASI-Messenger-${version}-${arch}.${ext}"
  }
}
